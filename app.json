{
  "expo": {
    "name": "luckybird",
    "slug": "luckybird",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F97316"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F97316"
      },
      "package": "com.mynger.luckybird"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "mynger",
    "extra": {
      "eas": {
        "projectId": "3298067e-992f-4cdd-a76c-84b33f06eab8"
      }
    },
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F97316",
          "imageWidth": 200
        }
      ]
    ]
  },
  "version": "1.0.1"
}
